{
    "manifest_version": 3,
    "name": "Sonara",
    "version": "2.7.0",
    "description": "Capture tweets and sync them to your Sonara workspace.",
    "permissions": [
        "storage",
        "alarms",
        "downloads",
        "tabs",
        "activeTab",
        "scripting",
        "sidePanel",
        "offscreen"
    ],
    "host_permissions": [
        "https://twitter.com/*",
        "https://x.com/*",
        "http://localhost:5000/*",
        "http://127.0.0.1:5000/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://twitter.com/*",
                "https://x.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ]
        },
        {
            "matches": [
                "http://localhost:5000/*",
                "http://127.0.0.1:5000/*",
                "https://nodes-oz1k.onrender.com/*"
            ],
            "js": [
                "oauth-capture.js"
            ],
            "run_at": "document_start"
        }
    ],
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "action": {
        "default_title": "Sonara",
        "default_icon": {
            "16": "icons/light/icon16.png",
            "48": "icons/light/icon48.png",
            "128": "icons/light/icon128.png"
        },
        "icon_variants": [
            {
                "16": "icons/light/icon16.png",
                "48": "icons/light/icon48.png",
                "128": "icons/light/icon128.png",
                "color_schemes": ["light"]
            },
            {
                "16": "icons/dark/icon16.png",
                "48": "icons/dark/icon48.png",
                "128": "icons/dark/icon128.png",
                "color_schemes": ["dark"]
            }
        ]
    },
    "icons": {
        "16": "icons/light/icon16.png",
        "48": "icons/light/icon48.png",
        "128": "icons/light/icon128.png"
    },
    "icon_variants": [
        {
            "16": "icons/light/icon16.png",
            "48": "icons/light/icon48.png",
            "128": "icons/light/icon128.png",
            "color_schemes": ["light"]
        },
        {
            "16": "icons/dark/icon16.png",
            "48": "icons/dark/icon48.png",
            "128": "icons/dark/icon128.png",
            "color_schemes": ["dark"]
        }
    ]
}
